{
  "info": {
    "name": "Event Manager - Iteration 4 (Kafka + Notifications)",
    "description": "End-to-end проверка итерации 4. Запускать по порядку (Collection Runner или вручную сверху вниз). Токены и id сохраняются автоматически. Требуется: docker compose up -d, оба сервиса запущены (8080/8081).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const jwt = pm.response.json().jwt;",
              "pm.collectionVariables.set('adminToken', jwt);",
              "pm.test('admin token saved', () => pm.expect(jwt).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"admin\"\n}" },
        "url": { "raw": "{{emUrl}}/users/auth", "host": [ "{{emUrl}}" ], "path": [ "users", "auth" ] }
      }
    },
    {
      "name": "2. Login as user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const jwt = pm.response.json().jwt;",
              "pm.collectionVariables.set('userToken', jwt);",
              "pm.test('user token saved', () => pm.expect(jwt).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"user\",\n  \"password\": \"user\"\n}" },
        "url": { "raw": "{{emUrl}}/users/auth", "host": [ "{{emUrl}}" ], "path": [ "users", "auth" ] }
      }
    },
    {
      "name": "3. Create location (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('locationId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hall A\",\n  \"address\": \"Main St 1\",\n  \"capacity\": 100,\n  \"description\": \"test hall\"\n}" },
        "url": { "raw": "{{emUrl}}/locations", "host": [ "{{emUrl}}" ], "path": [ "locations" ] }
      }
    },
    {
      "name": "4. Create event (user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('eventId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Java Meetup\",\n  \"maxPlaces\": 50,\n  \"date\": \"2026-09-01T10:00:00\",\n  \"cost\": 0,\n  \"duration\": 60,\n  \"locationId\": {{locationId}}\n}" },
        "url": { "raw": "{{emUrl}}/events", "host": [ "{{emUrl}}" ], "path": [ "events" ] }
      }
    },
    {
      "name": "5. Register user at event (user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{userToken}}" } ],
        "url": { "raw": "{{emUrl}}/events/registrations/{{eventId}}", "host": [ "{{emUrl}}" ], "path": [ "events", "registrations", "{{eventId}}" ] }
      }
    },
    {
      "name": "6. Update event -> publishes to Kafka (user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Java Meetup Renamed\",\n  \"maxPlaces\": 40,\n  \"date\": \"2026-09-02T10:00:00\",\n  \"cost\": 10,\n  \"duration\": 90,\n  \"locationId\": {{locationId}}\n}" },
        "url": { "raw": "{{emUrl}}/events/{{eventId}}", "host": [ "{{emUrl}}" ], "path": [ "events", "{{eventId}}" ] }
      }
    },
    {
      "name": "7. GET notifications (user)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Kafka обрабатывается асинхронно — ждём ~1.5с, чтобы уведомление успело создаться",
              "const end = Date.now() + 1500;",
              "while (Date.now() < end) { /* busy wait */ }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const arr = pm.response.json();",
              "const eventId = pm.collectionVariables.get('eventId');",
              "const forThisEvent = arr.filter(n => String(n.eventId) === String(eventId));",
              "pm.test('есть уведомление по нашему событию (если пусто — подожди 1-2с и повтори)', () => pm.expect(forThisEvent.length).to.be.above(0));",
              "pm.test('ДЕДУП: ровно 1 уведомление по событию (владелец = участник)', () => pm.expect(forThisEvent.length).to.eql(1));",
              "if (forThisEvent.length > 0) {",
              "  const n = forThisEvent[0];",
              "  pm.collectionVariables.set('notificationId', n.notificationId);",
              "  console.log('message:', n.message);",
              "  console.log('type:', n.type, '| changes:', JSON.stringify(n.payload.changes));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{userToken}}" } ],
        "url": { "raw": "{{enUrl}}/notifications", "host": [ "{{enUrl}}" ], "path": [ "notifications" ] }
      }
    },
    {
      "name": "8. Mark as read + foreign id (user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 (чужой id 999 игнорируется без ошибки)', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": { "mode": "raw", "raw": "[{{notificationId}}, 999]" },
        "url": { "raw": "{{enUrl}}/notifications", "host": [ "{{enUrl}}" ], "path": [ "notifications" ] }
      }
    },
    {
      "name": "9. GET notifications after read (expect empty)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const readId = pm.collectionVariables.get('notificationId');",
              "const stillUnread = pm.response.json().filter(n => String(n.notificationId) === String(readId));",
              "pm.test('наше уведомление больше не в непрочитанных', () => pm.expect(stillUnread.length).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{userToken}}" } ],
        "url": { "raw": "{{enUrl}}/notifications", "host": [ "{{enUrl}}" ], "path": [ "notifications" ] }
      }
    },
    {
      "name": "10. Negative: no JWT -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('без токена -> 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{enUrl}}/notifications", "host": [ "{{enUrl}}" ], "path": [ "notifications" ] }
      }
    }
  ],
  "variable": [
    { "key": "emUrl", "value": "http://localhost:8080" },
    { "key": "enUrl", "value": "http://localhost:8081" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "locationId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "notificationId", "value": "" }
  ]
}
